# ==============================================================================
# Environment configuration template.
#
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit
# secrets. The same code (ingestion, dbt, Airflow, AI) runs unmodified across
# dev/staging/prod; only these values change per environment.
#
# ENVIRONMENT selects the dbt target (see dbt/delivery_pipeline/profiles/profiles.yml.example)
# and the Snowflake database each layer resolves to, e.g. DELIVERY_DEV / DELIVERY_STAGING / DELIVERY_PROD.
# ==============================================================================

# --- Environment selector -----------------------------------------------------
ENVIRONMENT=dev                     # dev | staging | prod

# --- Snowflake: shared connection ---------------------------------------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_WAREHOUSE=DELIVERY_WH
SNOWFLAKE_DATABASE=DELIVERY_DEV         # DELIVERY_DEV | DELIVERY_STAGING | DELIVERY_PROD

# --- Snowflake: role-scoped credentials (see docs/architecture/05-security.md) --
# One set of credentials/role per pipeline stage — least privilege, never one
# god-role. In prod these are injected by the orchestrator's secret backend,
# not read from a file.
SNOWFLAKE_LOADER_USER=              # writes RAW only
SNOWFLAKE_LOADER_PASSWORD=
SNOWFLAKE_LOADER_ROLE=LOADER_ROLE

SNOWFLAKE_TRANSFORM_USER=           # dbt: reads RAW, writes STAGING/MARTS/SEMANTIC
SNOWFLAKE_TRANSFORM_PASSWORD=
SNOWFLAKE_TRANSFORM_ROLE=TRANSFORM_ROLE

SNOWFLAKE_AI_ENRICH_USER=           # review enrichment: reads STAGING, writes AI schema
SNOWFLAKE_AI_ENRICH_PASSWORD=
SNOWFLAKE_AI_ENRICH_ROLE=AI_ENRICH_ROLE

SNOWFLAKE_AI_READONLY_USER=         # RAG + text-to-SQL: SELECT-only on SEMANTIC schema
SNOWFLAKE_AI_READONLY_PASSWORD=
SNOWFLAKE_AI_READONLY_ROLE=AI_READONLY_ROLE

# --- AWS / S3 landing zone -----------------------------------------------------
AWS_REGION=ap-southeast-2
S3_LANDING_BUCKET=delivery-pipeline-landing-dev
# Credentials are intentionally not listed here: the ingestion runner and
# Airflow assume an IAM role (instance profile / IRSA / OIDC in CI). Local dev
# may export AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY via `aws configure`
# instead of putting them in this file.

# --- OpenAI ---------------------------------------------------------------------
OPENAI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# --- AI enrichment batch tuning --------------------------------------------------
AI_ENRICHMENT_BATCH_SIZE=50
AI_ENRICHMENT_MAX_RETRIES=3
AI_ENRICHMENT_PROMPT_VERSION=v1

# --- Text-to-SQL guardrails -------------------------------------------------------
TEXT_TO_SQL_ROW_LIMIT=200
TEXT_TO_SQL_QUERY_TIMEOUT_SECONDS=30
TEXT_TO_SQL_ALLOWED_SCHEMA=SEMANTIC

# --- Airflow (docker/airflow/docker-compose.yaml) ---------------------------------
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=
AIRFLOW_API_JWT_SECRET=
